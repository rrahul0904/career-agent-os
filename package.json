{
  "name": "career-agent-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "dev": "node --watch apps/api/src/server.js",
    "start": "node apps/api/src/server.js",
    "worker": "node apps/worker/src/ingest.js",
